.DS_Store
._*
.hugo_build.lock
.hugo-check/
public/
resources/_gen/
static/CV.docx
.private/

# Local unpublished drafts. Keep the section marker, but never expose draft
# content through this public repository.
content/projects/drafts/*
!content/projects/drafts/_index.md
content/notes/drafts/*
!content/notes/drafts/_index.md
content/persona/drafts/*
!content/persona/drafts/_index.md

# Working assets for already-published content stay outside Hugo's content
# tree and remain local unless deliberately promoted into static/images.
local-assets/
